---
import '../styles/global.css';
import { SITE, withBase, type Lang } from '../config';
import { t } from '../i18n';

interface Props { lang: Lang; title?: string; description?: string; alt: string }
const { lang, title, description, alt } = Astro.props;
const d = t(lang);
const home = withBase(`/${lang}/`);
const other = lang === 'sk' ? 'en' : 'sk';
const logoColors = ['#efdfc5', '#c27150', '#93b08f', '#1f2b72'];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${SITE.name}` : d.meta.title}</title>
    <meta name="description" content={description ?? d.meta.desc} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" hreflang={other} href={alt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=DM+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a class="logo" href={home} aria-label={SITE.name}>
          <span class="logo-mark" aria-hidden="true">
            {logoColors.map((c) => <i style={`background:${c}`}></i>)}
          </span>
          <span>{SITE.name}</span>
        </a>
        <nav class="nav">
          <a href={`${home}#kusky`}>{d.nav.products}</a>
          <a href={`${home}#farby`}>{d.nav.colors}</a>
          <a href={`${home}#vyroba`}>{d.nav.process}</a>
          <a href={`${home}#kontakt`}>{d.nav.contact}</a>
        </nav>
        <a class="lang" href={alt} hreflang={other}>{other.toUpperCase()}</a>
      </div>
    </header>
    <main><slot /></main>
    <footer class="foot">
      <div class="wrap foot-in">
        <a class="logo" href={home}>
          <span class="logo-mark" aria-hidden="true">{logoColors.map((c) => <i style={`background:${c}`}></i>)}</span>
          <span>{SITE.name}</span>
        </a>
        <p>{d.footer.made}</p>
        <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a> · <a href={SITE.instagram} rel="noopener">{d.footer.ig}</a></p>
      </div>
    </footer>
    <script>
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }), { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .top { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 24px; height: 68px; }
  .logo { display: inline-flex; align-items: center; gap: 10px; font: 800 1.3rem var(--font-head); text-decoration: none; letter-spacing: -0.02em; }
  .logo-mark { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; width: 28px; height: 28px; padding: 2px; background: var(--ink); border-radius: 6px; transition: transform .3s; }
  .logo-mark i { border-radius: 2px; }
  .logo:hover .logo-mark { transform: rotate(90deg); }
  .nav { display: flex; gap: 22px; margin-left: auto; }
  .nav a { text-decoration: none; font-weight: 600; font-size: .95rem; }
  .nav a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .lang { font-weight: 700; font-size: .85rem; text-decoration: none; border: 2px solid var(--ink); border-radius: 8px; padding: 4px 9px; }
  .lang:hover { background: var(--ink); color: #fff; }
  @media (max-width: 760px) { .nav { display: none; } .lang { margin-left: auto; } }

  .foot { border-top: 1px solid var(--line); padding: 40px 0; color: var(--muted); }
  .foot-in { display: flex; flex-wrap: wrap; gap: 16px 32px; align-items: center; justify-content: space-between; }
  .foot .logo { color: var(--ink); }
</style>
