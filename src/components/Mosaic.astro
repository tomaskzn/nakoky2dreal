---
import { TILES } from '../data/colors';
import type { Lang } from '../config';
import { t } from '../i18n';
interface Props { lang: Lang }
const d = t(Astro.props.lang);
const cells = Array.from({ length: 24 * 8 });
const palette = JSON.stringify(TILES.map((x) => x.hex));
---
<section class="play section">
  <div class="wrap">
    <div class="play-head">
      <div>
        <h2>{d.play.title}</h2>
        <p>{d.play.hint}</p>
      </div>
      <button class="btn ghost" type="button" data-reset>{d.play.reset}</button>
    </div>
    <div class="mosaic" data-palette={palette}>
      {cells.map(() => <span></span>)}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.mosaic').forEach((m) => {
    const pal: string[] = JSON.parse(m.dataset.palette!);
    let last = '';
    const paint = (el: Element | null) => {
      if (!(el instanceof HTMLSpanElement) || el.parentElement !== m) return;
      let c = pal[Math.floor(Math.random() * pal.length)];
      if (c === last) c = pal[(pal.indexOf(c) + 1) % pal.length];
      last = c;
      el.style.background = c;
      el.classList.remove('pop'); void el.offsetWidth; el.classList.add('pop');
    };
    m.addEventListener('pointerover', (e) => paint(e.target as Element));
    m.addEventListener('touchmove', (e) => {
      const p = e.touches[0];
      paint(document.elementFromPoint(p.clientX, p.clientY));
      e.preventDefault();
    }, { passive: false });
    m.closest('section')?.querySelector('[data-reset]')?.addEventListener('click', () => {
      m.querySelectorAll('span').forEach((s, i) => setTimeout(() => (s.style.background = ''), (i % 24) * 15));
    });
  });
</script>

<style>
  .play { background: var(--ink); color: #fff; }
  .play-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 32px; flex-wrap: wrap; }
  .play-head p { color: #bdb6a9; margin-top: 10px; }
  .play .btn.ghost { color: #fff; border-color: #fff; }
  .play .btn.ghost:hover { background: #fff; color: var(--ink); }
  .mosaic {
    display: grid; grid-template-columns: repeat(24, 1fr); gap: 4px;
    padding: 4px; background: #f7f6f2; border-radius: 10px; touch-action: none; user-select: none;
  }
  .mosaic span { aspect-ratio: 1; background: #ebe5d8; border-radius: 3px; transition: background .25s; }
  .mosaic span.pop { animation: pop .35s ease; }
  @keyframes pop { 40% { transform: scale(.75) rotate(8deg); } }
  @media (max-width: 640px) {
    .mosaic { grid-template-columns: repeat(12, 1fr); }
    .mosaic span:nth-child(n + 97) { display: none; }
  }
</style>
